# Copy to .env (ignored by Git), replace every empty placeholder and restrict its
# permissions. compose.yaml loads it through env_file; never commit this file.
# Legacy .env.compose deployments: set COMPOSE_ENV_FILE=.env.compose and pass
# --env-file .env.compose to every Compose command.
COMPOSE_ENV_FILE=.env

# Empty starts no bundled dependency: DB_HOST and REDIS_HOST must point to
# external services. "database,redis" starts both; either value alone starts one.
# Equivalent to passing --profile database --profile redis.
COMPOSE_PROFILES=

IDENTITY_VERSION=v0.2.0
IDENTITY_BIND_PORT=8081

APP_URL=https://identity.example.com
APP_KEY=
# Exact reverse-proxy address or CIDR, comma separated. On a shared host use the
# ingress network CIDR, for example 172.18.0.0/16. Never trust every address.
TRUSTED_PROXIES=

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=identity_service
DB_USERNAME=identity_service
DB_PASSWORD=
DB_SSLMODE=prefer

REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null

# Sessions use REDIS_DB and the cache uses REDIS_CACHE_DB. This template
# allocates DB4 and DB5, which are distinct and avoid the commonly used 0/1 on a
# shared instance. Verify both databases are free before use. Keep them distinct:
# `cache:clear` flushes the whole cache database and would sign every
# administrator out if it were shared. The connection prefix makes the full
# cache key identity:cache:<key>; align the ACL key pattern with REDIS_PREFIX.
REDIS_DB=4
REDIS_CACHE_DB=5
REDIS_PREFIX=identity:
CACHE_PREFIX=cache:

# Network wiring. Set *_NETWORK_EXTERNAL=true and name the network created by
# the host stack; Compose then joins it instead of creating one per project.
POSTGRES_NETWORK_EXTERNAL=false
# POSTGRES_NETWORK=infra-postgres-private
REDIS_NETWORK_EXTERNAL=false
# REDIS_NETWORK=infra-redis-private
INGRESS_NETWORK_EXTERNAL=false
# INGRESS_NETWORK=ingress-nginx_default

IDENTITY_MEMORY_LIMIT=384m
IDENTITY_CPU_LIMIT=0.75
POSTGRES_MEMORY_LIMIT=256m
POSTGRES_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=96m
REDIS_CPU_LIMIT=0.2
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
