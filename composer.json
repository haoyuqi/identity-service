{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "haoyuqi/identity-service",
    "type": "project",
    "description": "Identity service for private administrative account management.",
    "keywords": ["laravel", "identity"],
    "license": "MIT",
    "require": {
        "php": "~8.4.27 || ^8.5.12",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "laravel/framework": "^13.17"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate"
        ],
        "test": "@php artisan test",
        "test:coverage": [
            "@php -r \"is_dir('build') || mkdir('build', 0777, true);\"",
            "@php artisan test --coverage --min=100 --coverage-clover=build/coverage.xml"
        ],
        "analyse": "@php vendor/bin/phpstan analyse --no-progress",
        "format": "@php vendor/bin/pint",
        "format:check": "@php vendor/bin/pint --test",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
